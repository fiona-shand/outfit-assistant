# Password you type to sign in to the app
APP_PASSWORD=
# Long random string used to sign the login cookie (e.g. `openssl rand -hex 32`)
AUTH_SECRET=

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Web push keys: run `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret the Supabase cron job sends (e.g. `openssl rand -hex 24`)
CRON_SECRET=
